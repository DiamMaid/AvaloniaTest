<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AvaloniaTest.ViewModels"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="AvaloniaTest.Views.AuthView"
             x:DataType="vm:AuthViewModel">

    <Border Classes="card">
        <Grid RowDefinitions="*,Auto">

            <StackPanel Grid.Row="0" Classes="stack">

                <!-- ============ Состояние 1: пользователь НЕ авторизован — форма входа ============ -->
                <StackPanel Classes="stack" IsVisible="{Binding !IsAuthenticated}">
                    <TextBlock Classes="h2" Text="Авторизация" />
                    <TextBlock Classes="secondary"
                               Text="Введите email и пароль, чтобы получить доступ к профилю." />

                    <TextBlock Classes="label" Text="Email" />
                    <TextBox Classes="form"
                             PlaceholderText="email@example.com"
                             Text="{Binding Email, Mode=TwoWay}" />

                    <TextBlock Classes="label" Text="Пароль" />
                    <TextBox x:Name="PasswordBox"
                             Classes="form"
                             PlaceholderText="Пароль"
                             PasswordChar="•"
                             RevealPassword="{Binding #RevealPasswordCheckBox.IsChecked, Mode=OneWay}"
                             Text="{Binding Password, Mode=TwoWay}" />
                    <CheckBox x:Name="RevealPasswordCheckBox" Content="Показать пароль" />

                    <Button Classes="accent"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Command="{Binding LoginCommand}"
                            Content="Войти"
                            IsEnabled="{Binding !IsBusy}" />
                </StackPanel>

                <!-- ============ Состояние 2: пользователь авторизован ============ -->
                <StackPanel Classes="stack" IsVisible="{Binding IsAuthenticated}">
                    <TextBlock Classes="h2" Text="Вы авторизованы" />
                    <StackPanel Classes="hstack" Spacing="4">
                        <TextBlock Classes="secondary" Text="Вы вошли как" />
                        <SelectableTextBlock Classes="secondary" Text="{Binding CurrentUserEmail}" />
                    </StackPanel>
                </StackPanel>

                <!-- ============ Индикатор занятости ============ -->
                <StackPanel Classes="hstack" IsVisible="{Binding IsBusy}">
                    <ProgressBar Classes="busy"
                                 Width="120"
                                 Margin="0"
                                 VerticalAlignment="Center"
                                 IsIndeterminate="True" />
                    <TextBlock Classes="secondary" VerticalAlignment="Center" Text="Выполняется запрос..." />
                </StackPanel>

                <!-- ============ Ошибка ============ -->
                <TextBlock Classes="error"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                           Text="{Binding ErrorMessage}" />
            </StackPanel>

            <!-- Нижняя кнопка блока по эталону: регистрация без сессии, выход при активной сессии. -->
            <Button Grid.Row="1"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Command="{Binding RegisterCommand}"
                    Content="Регистрация"
                    IsEnabled="{Binding !IsBusy}"
                    IsVisible="{Binding !IsAuthenticated}" />
            <Button Grid.Row="1"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Command="{Binding LogoutCommand}"
                    Content="Выйти"
                    IsEnabled="{Binding !IsBusy}"
                    IsVisible="{Binding IsAuthenticated}" />
        </Grid>
    </Border>
</UserControl>
